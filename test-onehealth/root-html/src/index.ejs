  <% if (isLocal) { %>
    <script>
      var appConfigs = {
        tutorial: "http://localhost:15568/main.js",
        admin: "http://localhost:15569/main.js",
        his: "http://localhost:15570/main.js",
        "@vnpt/root-config": "/vnpt-root-config.js",
      };
    </script>
    <% } else { %>
      <script>
        var appConfigs = {
          // tutorial: "/tutorial/main.js",
          tutorial: "/main.js",
          admin: "/admin/news/main.js",
          his: "/his/main.js",
          "@vnpt/root-config": "/vnpt-root-config.js",
        };
      </script>
      <% } %>
        <script>
          var layout = `

        <!-- ADMIN -->
        <redirect from="/admin" to="/admin/news"></redirect>
        <route path="/admin">
          <application name="admin"></application>
        </route>

        <!-- HIS -->
        <redirect from="/his" to="/his/tiepnhan"></redirect>
        <route path="/his">
          <application name="his"></application>
        </route>

        <!-- TUTORIAL (ROOT APP) -->
        <route default>
          <application name="tutorial"></application>
        </route>
      `;
          var onehealthUI = new OnehealthUI(appConfigs, layout);
          System.import("@vnpt/root-config");
        </script>
