  <% if (isLocal) { %>
    <script>
      var appConfigs = {
        tutorial: "http://localhost:15568/main.js",
        "@vnpt/root-config": "/vnpt-root-config.js",
      };
    </script>
  <% } else { %>
    <script>
      var appConfigs = {
        tutorial: "/tutorial/main.js",
        "@vnpt/root-config": "/vnpt-root-config.js",
      };
    </script>
  <% } %>
  <script>
      var layout = `
        <redirect from="/" to="/tutorial"></redirect>
        <route path="/tutorial"><application name="tutorial"></application></route>
        <route default><application name="tutorial"></application></route>
      `;
      var onehealthUI = new OnehealthUI(appConfigs, layout);
      System.import("@vnpt/root-config");
  </script>
  
